    alias d_friday="export MGC_HOME=/wv/icdet/work_areas/d_friday/ic/ic_superproj/${VCO}/Mgc_home"



# Dynamic Calibre Alias Generator
for dir in /wv/icdet/work_areas/calibre_*; do
    if [ -d "$dir" ]; then
        # Extract YYYY_Q from directory name (e.g., calibre_2016_1 -> 2016_1)
        ver_raw=$(basename "$dir" | sed 's/calibre_//')
        
        # Split into Year and Quarter
        year_full=$(echo "$ver_raw" | cut -d'_' -f1)
        qtr=$(echo "$ver_raw" | cut -d'_' -f2)
        
        # Format year: 2008 -> 8, 2016 -> 16
        year_short=$(echo "$year_full" | sed 's/^20//' | sed 's/^0//')
        
        # Define the alias
        # Note: We escape ${VCO} so it is evaluated when the alias is CALLED, not defined.
        alias "${year_short}.${qtr}_cal"="export MGC_HOME=$dir/ic/ic_superproj/\${VCO}/Mgc_home"
    fi
done

