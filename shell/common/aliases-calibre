
if [ ! -d "/wv/icdet/work_areas" ] || [ ! -d "/wv/pevtools/bin" ]; then
    return
fi
    # Useful alias to=point MGC_HOME at latest build (d_top_last is a symlink that always points at the latest TOT build):
